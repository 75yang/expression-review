# Optional online AI. No key is needed for /demo or local filler discovery.
MODEL_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Alternative provider; configure only on your own computer.
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional local transcription. Python and ffprobe must be installed separately.
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
